# The local defaults work without an .env file.
OBERTH_DATABASE_DRIVER=embedded
OBERTH_DATABASE_DSN=
OBERTH_SERVER_PORT=9090
# Maximum duration of each provider/model attempt (Go duration syntax).
OBERTH_LLM_ATTEMPT_TIMEOUT=5m
VITE_API_URL=http://localhost:9090
# Leave unset to generate a random per-bootstrap local token.
OBERTH_AUTH_TOKEN=
VITE_API_TOKEN=
# Optional advanced PostgreSQL/Qdrant stack:
OBERTH_ADVANCED_DOCKER=0
